{
  "augmentation": {
    "blur_max_radius": 1.5,
    "blur_probability": 0.15,
    "color_jitter_strength": 0.15,
    "grayscale_probability": 0.05,
    "horizontal_flip_probability": 0.5,
    "vertical_flip_probability": 0.5
  },
  "data": {
    "absolute_path_column": "absolute_path",
    "cohort_column": "cohort_id",
    "filename_column": "file_name",
    "id_column": "image_id",
    "manifest": "outputs/dataset_manifests/adaptation.csv",
    "maximum_excluded_fraction": 0.05,
    "prepared_manifest": "outputs/dinov3_mixed_domain_adaptation/prepared_manifest.csv",
    "relative_path_column": "relative_path",
    "split_seed": 42,
    "validation_fraction": 0.1
  },
  "experiment": {
    "name": "dinov3_mixed_domain_adaptation"
  },
  "model": {
    "backbone": "facebook/dinov3-vitb16-pretrain-lvd1689m",
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "lora_rank": 8,
    "lora_target_modules": [
      "q_proj",
      "v_proj"
    ],
    "processor": "facebook/dinov3-vitb16-pretrain-lvd1689m",
    "train_final_norm": true
  },
  "objective": {
    "cross_view_weight": 1.0,
    "same_view_anchor_weight": 0.25
  },
  "output": {
    "audit_dir": "audit_100",
    "audit_sample_size": 100,
    "best_checkpoint_name": "best.pt",
    "export_dir": "adapted_backbone",
    "failure_log": "input_exclusions.jsonl",
    "inspection_dir": "tile_inspection",
    "last_checkpoint_name": "last.pt",
    "run_dir": "outputs/dinov3_mixed_domain_adaptation",
    "samples_per_cohort": 2,
    "samples_per_source": 8,
    "save_plots": true,
    "source_inspection_dir": "source_inspection"
  },
  "runtime": {
    "allow_tf32": true,
    "deterministic": true,
    "device": "auto",
    "mixed_precision": "fp16",
    "pin_memory": true
  },
  "tiles": {
    "grid_sizes": [
      3,
      4
    ],
    "label_overlap_limit": 0.02,
    "mask_analysis_max_side": 768,
    "overlap_fraction": 0.15,
    "plant_biased_probability": 0.7,
    "preview_tiles_per_image": 4,
    "vegetation_score_power": 1.0
  },
  "training": {
    "batch_size": 8,
    "early_stopping_min_delta": 0.0001,
    "early_stopping_patience": 5,
    "epochs": 20,
    "eval_every": 1,
    "gradient_accumulation_steps": 2,
    "gradient_clip_norm": 1.0,
    "learning_rate": 0.0001,
    "minimum_learning_rate_ratio": 0.05,
    "num_workers": 4,
    "seed": 42,
    "warmup_fraction": 0.1,
    "weight_decay": 0.0
  }
}
