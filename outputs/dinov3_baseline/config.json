{
  "data": {
    "dataset_dir": "/home/nfs/data/nvme_datasets/Pictures_CFSB_leaf_damage/RSFB-Phenotyping_training_set/RSFB-Phenotyping_training_set",
    "filename_column": "Filename",
    "image_extension": ".jpg",
    "scores_file": "RSFB-Phenotyping_training_set_scores.csv",
    "split_seed": 42,
    "target_column": "mean_score",
    "validation_fraction": 0.33,
    "verify_images": true
  },
  "experiment": {
    "name": "dinov3_baseline"
  },
  "model": {
    "backbone": "facebook/dinov3-vitb16-pretrain-lvd1689m",
    "dropout": 0.1,
    "freeze_backbone": true,
    "head_hidden_dim": 256,
    "processor": "facebook/dinov3-vits16-pretrain-lvd1689m"
  },
  "output": {
    "best_checkpoint_name": "best.pt",
    "example_columns": 4,
    "example_images": 12,
    "last_checkpoint_name": "last.pt",
    "run_dir": "outputs/dinov3_baseline",
    "save_plots": true
  },
  "runtime": {
    "deterministic": true,
    "device": "auto",
    "pin_memory": true
  },
  "training": {
    "batch_size": 16,
    "epochs": 30,
    "eval_every": 6,
    "learning_rate": 0.001,
    "num_workers": 4,
    "seed": 42,
    "weight_decay": 0.0001
  }
}
