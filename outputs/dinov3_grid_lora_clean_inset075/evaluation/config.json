{
  "augmentation": {
    "color_jitter_strength": 0.05,
    "enabled": true,
    "horizontal_flip_probability": 0.5,
    "vertical_flip_probability": 0.5
  },
  "data": {
    "dataset_dir": "/home/nfs/data/nvme_datasets/Pictures_CFSB_leaf_damage/RSFB-Phenotyping_training_set/RSFB-Phenotyping_training_set",
    "filename_column": "Filename",
    "grid_cache_dir": "cache/grid_crops_1400_inset075",
    "grid_crop_size": 1400,
    "grid_inner_margin_fraction": 0.075,
